{
    "name": "backup-manager/laravel",
    "description": "Database backup manager integrated with Laravel: back up and restore MySQL and PostgreSQL to S3, Google Cloud Storage, Dropbox, FTP, SFTP, WebDAV and more.",
    "license": "MIT",
    "keywords": [
        "laravel",
        "backup",
        "database",
        "mysql",
        "postgresql",
        "s3",
        "flysystem"
    ],
    "authors": [
        {
            "name": "Shawn McCool",
            "email": "shawn@heybigname.com",
            "homepage": "https://shawnmc.cool"
        }
    ],
    "require": {
        "php": "^8.2",
        "backup-manager/backup-manager": "^4.1",
        "illuminate/console": "^12.71.0 || ^13.40.0",
        "illuminate/container": "^12.71.0 || ^13.40.0",
        "illuminate/contracts": "^12.71.0 || ^13.40.0",
        "illuminate/support": "^12.71.0 || ^13.40.0",
        "league/flysystem": "^3.35.3",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/process": "^7.4.5 || ^8.0.5"
    },
    "require-dev": {
        "mockery/mockery": "^1.6.12",
        "orchestra/testbench": "^10.12 || ^11.3",
        "phpunit/phpunit": "^11.5.50 || ^12.5.8"
    },
    "autoload": {
        "psr-4": {
            "BackupManager\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BackupManager\\Laravel\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.x-dev"
        },
        "laravel": {
            "providers": [
                "BackupManager\\Laravel\\Laravel55ServiceProvider"
            ]
        }
    }
}
